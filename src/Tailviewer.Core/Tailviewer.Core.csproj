<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- shortcut: retain net45 for the WPF host, remove when the host and plugin tools migrate. -->
    <TargetFrameworks>net45;net10.0</TargetFrameworks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- BuildDate reads the PE linker timestamp. -->
    <Deterministic>false</Deterministic>
    <LangVersion>14.0</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../sig/key.snk</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!-- shortcut: net45 still uses legacy log4net; remove this warning exception with the WPF host. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902</WarningsNotAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net45'">
    <OutputPath>../../bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GlobalAssemblyInfo.cs" Link="Properties/GlobalAssemblyInfo.cs" />
    <ProjectReference Include="../Tailviewer.Api/Tailviewer.Api.csproj" />
    <PackageReference Include="System.Threading.Extensions" Version="2.0.72" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net45'">
    <PackageReference Include="log4net" Version="2.0.12" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <None Remove="app.config" />
    <PackageReference Include="log4net" Version="3.6.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
  </ItemGroup>
</Project>
