<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- shortcut: retain net452 for legacy desktop/service consumers until their migration. -->
    <TargetFrameworks>net452;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>archive</AssemblyName>
    <RootNamespace>Tailviewer.Archiver</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../sig/key.snk</AssemblyOriginatorKeyFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- shortcut: retain the visible legacy log4net advisory until the net452 consumers migrate. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902</WarningsNotAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net452'">
    <OutputPath>../../bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GlobalAssemblyInfo.cs" Link="Properties/GlobalAssemblyInfo.cs" />
    <ProjectReference Include="../Tailviewer.Api/Tailviewer.Api.csproj" />
    <ProjectReference Include="../Tailviewer.Core/Tailviewer.Core.csproj" />
    <PackageReference Include="CommandLineParser" Version="2.5.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="log4net" Version="3.6.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <None Remove="App.config" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net452'">
    <PackageReference Include="log4net" Version="2.0.12" />
    <PackageReference Include="Metrolib" Version="0.3.0.162" />
    <PackageReference Include="PE" Version="0.1.13" />
    <PackageReference Include="SharpRemote" Version="0.6.184" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <Target Name="EmbedLegacyDependencies" BeforeTargets="CreateManifestResourceNames" DependsOnTargets="ResolveReferences" Condition="'$(TargetFramework)' == 'net452'">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'CommandLine' Or '%(Filename)' == 'log4net' Or '%(Filename)' == 'Metrolib' Or '%(Filename)' == 'Tailviewer.Api' Or '%(Filename)' == 'SharpRemote' Or '%(Filename)' == 'PE' Or '%(Filename)' == 'System.Extensions'">
        <LogicalName>Tailviewer.Archiver.Resources.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
