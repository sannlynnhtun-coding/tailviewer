<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net471;net10.0</TargetFrameworks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../sig/key.snk</AssemblyOriginatorKeyFile>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net471'">
    <OutputPath>../../bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Include="../Tailviewer.Tests/Settings/ApplicationSettingsTest.cs" Link="Migration/LegacyApplicationSettingsTest.cs" />
    <None Include="../Tailviewer.Tests/Settings/settings_no_file_guid.xml" Link="Settings/settings_no_file_guid.xml" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Tailviewer.Tests/Settings/Bookmarks/BookmarksTest.cs" Link="Migration/LegacyBookmarksTest.cs" />
    <Compile Include="../Tailviewer.Tests/Settings/MainWindowSettingsTest.cs" Link="Migration/LegacyMainWindowSettingsTest.cs" />
    <Compile Include="../Tailviewer.Tests/DesktopTest.cs" Link="Migration/LegacyDesktopTest.cs" />
    <Compile Include="../Tailviewer.Tests/RectangleTest.cs" Link="Migration/LegacyRectangleTest.cs" />
    <Compile Include="../Tailviewer.Tests/Settings/LogLevelSettingsTest.cs" Link="Migration/LegacyLogLevelSettingsTest.cs" />
    <Compile Include="../Tailviewer.Tests/Settings/LogViewerSettingsTest.cs" Link="Migration/LegacyLogViewerSettingsTest.cs" />
    <Compile Include="../Tailviewer.Tests/Settings/AutoUpdateSettingsTest.cs" Link="Migration/LegacyAutoUpdateSettingsTest.cs" />
    <Compile Include="../Tailviewer.Tests/Settings/DataSourceTest.cs" Link="Migration/LegacyDataSourceTest.cs" />
    <Compile Include="../Tailviewer.Tests/Settings/DataSourceSettingsTest.cs" Link="Migration/LegacyDataSourceSettingsTest.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Tailviewer.Api/Tailviewer.Api.csproj" />
    <ProjectReference Include="../Tailviewer.Core/Tailviewer.Core.csproj" />
    <ProjectReference Include="../Tailviewer.Api.Tests/Tailviewer.Api.Tests.csproj" />
    <PackageReference Include="FluentAssertions" Version="5.6.0" />
    <PackageReference Include="NUnit" Version="3.12.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.7.127" />
  </ItemGroup>
</Project>
