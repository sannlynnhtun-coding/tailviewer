<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>2.0.0-alpha.2</Version>
    <ApplicationIcon>../Tailviewer/Resources/Tailviewer.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tailviewer.Avalonia.Tests" />
    <AvaloniaResource Include="Assets/Tailviewer.png" />
    <ProjectReference Include="../Tailviewer.Core/Tailviewer.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>
</Project>
