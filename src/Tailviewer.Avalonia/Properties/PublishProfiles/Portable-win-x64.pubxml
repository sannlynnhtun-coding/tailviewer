<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ReleaseContent>$(MSBuildProjectDirectory)/../../artifacts/publish/tailviewer-$(Version)-win-x64</ReleaseContent>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(ReleaseContent)/LICENSE;$(ReleaseContent)/THIRD-PARTY-NOTICES.md">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="$(ReleaseContent)/licenses/**/*">
      <Link>licenses/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CheckReleaseNotices" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('$(ReleaseContent)/LICENSE') Or !Exists('$(ReleaseContent)/THIRD-PARTY-NOTICES.md')" Text="Prepare the full release folder, including LICENSE and third-party notices, before publishing the portable EXE." />
  </Target>
</Project>
