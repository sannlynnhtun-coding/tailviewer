<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SourceEntryPointTest.cs" />
    <Compile Include="NativeOleDrag.cs" />
    <Compile Include="NativeKeyboard.cs" />
    <Compile Include="../../Tailviewer.Avalonia/SingleApplicationHelper.cs" Link="Shared/SingleApplicationHelper.cs" />
    <ProjectReference Include="../../Tailviewer.Avalonia/Tailviewer.Avalonia.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="NUnit" Version="3.12.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>
  <!-- shortcut: isolated native fixture runner; consolidate the legacy acceptance project in T117. -->
  <Target Name="CopyNativeApplication" AfterTargets="Build">
    <ItemGroup>
      <NativeApplication Include="$(MSBuildProjectDirectory)/../../Tailviewer.Avalonia/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeApplication)" DestinationFiles="@(NativeApplication->'$(OutDir)app/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
