<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GlobalAssemblyInfo.cs" Link="Properties/GlobalAssemblyInfo.cs" />
    <Compile Include="../Tailviewer.Tests/Appender.cs" Link="Shared/Appender.cs" />
    <Compile Include="../Tailviewer.Api.Tests/PathEx.cs" Link="Shared/PathEx.cs" />
    <Compile Include="../Tailviewer.Api.Tests/IssueAttribute.cs" Link="Shared/IssueAttribute.cs" />
    <Compile Remove="Migration/bin/**/*.cs;Migration/obj/**/*.cs" />
    <ProjectReference Include="../Tailviewer.Archiver/Tailviewer.Archiver.csproj" />
    <PackageReference Include="NUnit" Version="3.12.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="FluentAssertions" Version="5.6.0" />
    <PackageReference Include="Moq" Version="4.7.127" />
    <None Update="TestData/**/*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="TestData/cropped-uiforetwicon2.png" LogicalName="MetadataTest.Icon.png" />
  </ItemGroup>
</Project>
